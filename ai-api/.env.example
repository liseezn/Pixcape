# Set these in the deployment platform's secret/environment settings.
# Never add real API keys to Git or VITE_* frontend variables.
GEMINI_API_KEY=
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image\n# Legacy single-model alias: GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODELS=gpt-image-1,gpt-image-1.5\n# Legacy single-model alias: OPENAI_IMAGE_MODEL=gpt-image-1
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODELS=\n# Legacy single-model alias: OPENROUTER_IMAGE_MODEL=
AI_DEFAULT_PROVIDER=auto
AI_MAX_UPLOAD_MB=8
AI_RATE_LIMIT_PER_MINUTE=5
AI_TIMEOUT_MS=90000
# Comma-separated exact frontend origins; leave empty only for local development.
AI_ALLOWED_ORIGINS=http://localhost:5173
PORT=8787
